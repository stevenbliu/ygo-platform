{
  "name": "ygo-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "e2e": "playwright test",
    "dev:worker": "node scripts/dev-worker.mjs",
    "ux": "node scripts/ux/audit.mjs",
    "scenes": "playwright test -c playwright.scenes.config.ts",
    "scenes:record": "node scripts/ux/record-scenes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "vitest run src/worker/duel/engine/combos.test.ts src/worker/duel/engine/mechanics.test.ts src/worker/duel/engine/extraDeck.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cards:import:local": "node --experimental-strip-types scripts/import-cards.ts --local",
    "cards:import:remote": "node --experimental-strip-types scripts/import-cards.ts --remote",
    "cf-typegen": "wrangler types",
    "engine:import:local": "node --experimental-sqlite --experimental-strip-types scripts/import-engine-data.ts --local --all-scripts",
    "engine:import:remote": "node --experimental-sqlite --experimental-strip-types scripts/import-engine-data.ts --remote --all-scripts",
    "genesys:update": "node --experimental-strip-types scripts/update-genesys.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "ocgcore-wasm": "^0.1.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "source-map-js": "^1.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "license": "AGPL-3.0-or-later"
}
